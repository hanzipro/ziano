# Re-include docs/ — the user's global ~/.gitignore_global excludes it,
# but this repo's specs/plans live under docs/.
!/docs/

node_modules/
dist/
*.log
.DS_Store
.cache/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Scratch: task plans, todos, session notes, throwaway probes.
# Durable findings get rewritten into docs/notes/ and committed.
.ideas/
